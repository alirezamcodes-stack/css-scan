{
  "manifest_version": 3,
  "name": "StyleScan Ultra",
  "short_name": "StyleScan",
  "version": "0.2.0",
  "description": "Inspect, copy, and edit CSS directly on any supported web page.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "StyleScan Ultra",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open StyleScan Ultra"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/overlay.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
